# Shoulder Watch configuration. Copy to .env and fill in what you have.
# Everything is optional: missing keys switch that feature off, they never crash the app.

# --- AI confirmation (Google Gemini). Server-side only; never exposed to the browser. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Official 511GA comparison. Leave empty until your developer key is approved. ---
# Docs: https://511ga.org/developers/doc  (limit: 10 calls / 60 s; we cache and throttle)
SHOULDERWATCH_511GA_KEY=

# --- iMessage agent via Photon Spectrum (spectrum-ts). Get these at https://app.photon.codes ---
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# --- Map basemap (optional). CARTO now requires a free key: https://carto.com/basemaps/apikey ---
# Public by design (it is part of every tile URL the browser loads). Without it the map uses
# standard OpenStreetMap tiles, darkened in CSS.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=

# --- Optional tuning ---
# Polite identifier sent with every image request.
SHOULDERWATCH_USER_AGENT=ShoulderWatch/0.1 (Hacklanta 2026 hackathon project)
# Where the worker writes frames / detections (dashboard reads the same folder).
SHOULDERWATCH_DATA_DIR=./data
# Hours to keep flagged detection snapshots before deleting them.
SHOULDERWATCH_SNAPSHOT_RETENTION_HOURS=24
